---
import Site from '../layouts/Site.astro';
import { url } from '../lib/base';
import { SITE_SLUG, CONTACT_COLLECTION, TURNSTILE_SITE_KEY } from '../site-config';

// Where the contact form posts. Reads the admin base URL from a public env
// var at build time (same pattern as the template's ContactForm), falling
// back to the production admin. An unset repo variable resolves to an empty
// string, so treat empty the same as unset.
const API_BASE = import.meta.env.PUBLIC_SCRIBE_API_URL || 'https://scribe.weaverdigital.io';
const submissionEndpoint = `${API_BASE}/api/submissions`;
---
<Site
  title="Contact | Rod's Auto Body"
  description="Contact Rod's Auto Body in Lancaster, PA. No appointment needed, walk-ins welcome, Mon-Fri 7AM-4PM."
  active="contact"
>
  <section class="page-header texture-panel">
    <div class="container">
      <div class="breadcrumb"><a href={url('/')}>Home</a> / Contact</div>
      <span class="eyebrow">Get In Touch</span>
      <span class="stripe-mark on-dark" aria-hidden="true"><span class="bar"></span><span class="point"></span></span>
      <h1>Contact Us</h1>
      <p>No appointment needed &mdash; walk-ins are always welcome. Have a question first? Send us a message below.</p>
    </div>
    <div class="skew-edge" style="background: var(--white);"></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-grid">

        <div class="contact-info">
          <h3>Visit or Call</h3>
          <ul class="contact-info-list">
            <li>
              <span class="info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-7.5 7-12a7 7 0 1 0-14 0c0 4.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
              <span><span class="label">Address</span>885 Ivy Dr, Lancaster, PA 17601</span>
            </li>
            <li>
              <span class="info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/></svg></span>
              <span><span class="label">Phone</span><a href="tel:7172855575">(717) 285-5575</a></span>
            </li>
            <li>
              <span class="info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
              <span><span class="label">Hours</span>Mon&ndash;Fri 7AM&ndash;4PM &middot; Closed Sat&ndash;Sun</span>
            </li>
            <li>
              <span class="info-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              <span><span class="label">Appointments</span>No appointment needed &mdash; walk-ins welcome</span>
            </li>
          </ul>

          <div class="map-embed">
            <iframe
              src="https://www.google.com/maps?q=885+Ivy+Dr,+Lancaster,+PA+17601&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Map to Rod's Auto Body, 885 Ivy Dr, Lancaster, PA 17601">
            </iframe>
          </div>
        </div>

        <div>
          <h3>Send a Message</h3>
          <form class="contact-form" id="contact-form" data-site={SITE_SLUG} data-collection={CONTACT_COLLECTION} data-endpoint={submissionEndpoint}>
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
              <label for="contact">Phone or Email</label>
              <input type="text" id="contact" name="contact" required>
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" required></textarea>
            </div>
            <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
            <button type="submit" class="btn btn-primary">Send Message</button>
            <p class="form-note">Prefer to talk now? Call <a href="tel:7172855575">(717) 285-5575</a> &mdash; or just stop by, no appointment needed.</p>
            <p class="form-status" id="form-status"></p>
          </form>
        </div>

      </div>
    </div>
  </section>
</Site>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var status = document.getElementById('form-status');
    if (!form || !status) return;

    var site = form.dataset.site;
    var collection = form.dataset.collection;
    var endpoint = form.dataset.endpoint;

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var submitBtn = form.querySelector('button[type="submit"]');
      var tokenField = form.querySelector('[name="cf-turnstile-response"]');
      var payload = {
        name: form.name.value.trim(),
        contact: form.contact.value.trim(),
        message: form.message.value.trim(),
        'cf-turnstile-response': tokenField ? tokenField.value : ''
      };

      submitBtn.disabled = true;
      status.classList.remove('show');

      var url = endpoint + '?site=' + encodeURIComponent(site) + '&collection=' + encodeURIComponent(collection);
      fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (res) {
          if (!res.ok) { throw new Error('Request failed'); }
          form.reset();
          status.textContent = "Thanks for reaching out! We'll get back to you shortly.";
          status.classList.add('show');
        })
        .catch(function () {
          status.textContent = 'Sorry, something went wrong sending your message. Please call (717) 285-5575 instead.';
          status.classList.add('show');
        })
        .finally(function () {
          submitBtn.disabled = false;
        });
    });
  })();
</script>
