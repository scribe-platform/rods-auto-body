---
import Site from '../layouts/Site.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import { url } from '../lib/base';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
const reviews = (await getCollection('reviews')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
const stars = (n = 5) => '★'.repeat(n);
---
<Site
  title="Rod's Auto Body | Collision Repair in Lancaster, PA"
  description="Rod's Auto Body has served Lancaster, PA for 30+ years with collision repair, paintless dent repair, and glass replacement. All insurance welcome. Walk-ins welcome, no appointment needed."
  active="home"
>
  <section class="hero texture-panel">
    <div class="container">
      <div class="hero-content">
        <span class="eyebrow">Lancaster, PA &middot; 30+ Years in Business</span>
        <span class="stripe-mark on-dark" aria-hidden="true"><span class="bar"></span><span class="point"></span></span>
        <h1>Collision Repair Done Right, the First Time</h1>
        <p>From dents and scratches to full collision repair, Rod's Auto Body gets you back on the road. Every insurance company welcome &mdash; no appointment needed, walk-ins welcome.</p>
        <div class="hero-actions">
          <a href={url('/contact')} class="btn btn-primary">Get in Touch</a>
          <a href="tel:7172855575" class="btn btn-outline">Call (717) 285-5575</a>
        </div>
      </div>
      <div class="hero-photos">
        <img class="hero-photo hero-photo-back" src={url('/images/photos/605374-Sequoia.w1024.jpg')} alt="SUV repaired at Rod's Auto Body">
        <img class="hero-photo hero-photo-front" src={url('/images/photos/605372-IMG_1090.jpg')} alt="Vehicle repaired at Rod's Auto Body">
      </div>
    </div>
    <div class="skew-edge" style="background: var(--section-bg); bottom: -60px; height: 106px;"></div>
  </section>

  <div class="trust-bar">
    <div class="container">
      <div class="trust-item"><span class="dot"></span> All Makes &amp; Models Serviced</div>
      <div class="trust-item"><span class="dot"></span> Every Insurance Company Welcome</div>
      <div class="trust-item"><span class="dot"></span> Walk-Ins Welcome, No Appointment Needed</div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What We Do</span>
        <span class="stripe-mark" aria-hidden="true"><span class="bar"></span><span class="point"></span></span>
        <h2>Our Services</h2>
        <p>Full-service collision repair and support, all under one roof.</p>
      </div>

      <div class="services-grid">
        {services.map((s) => (
          <div class="service-card">
            <div class="icon"><ServiceIcon name={s.data.icon} /></div>
            <h3 set:html={s.data.cardTitle ?? s.data.title} />
            <p>{s.data.shortDescription}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our Work</span>
        <span class="stripe-mark" aria-hidden="true"><span class="bar"></span><span class="point"></span></span>
        <h2>Recent Vehicles</h2>
        <p>A look at some of the vehicles that have come through our shop.</p>
      </div>

      <div class="gallery-grid gallery-bento">
        <div class="gallery-item bento-main"><img src={url('/images/photos/605375-Jetta2.w1024.jpg')} alt="Vehicle serviced at Rod's Auto Body"></div>
        <div class="gallery-item bento-wide"><img src={url('/images/photos/605373-IMG_0498.w1024.jpg')} alt="Vehicle serviced at Rod's Auto Body"></div>
        <div class="gallery-item"><img src={url('/images/photos/605369-IMG_1224.jpg')} alt="Vehicle serviced at Rod's Auto Body"></div>
        <div class="gallery-item"><img src={url('/images/photos/605371-IMG_0165.jpg')} alt="Vehicle serviced at Rod's Auto Body"></div>
      </div>

      <div class="gallery-cta">
        <a href={url('/gallery')} class="btn btn-primary">View Full Gallery</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        <span class="stripe-mark" aria-hidden="true"><span class="bar"></span><span class="point"></span></span>
        <h2>What Our Customers Say</h2>
        <p class="rating-summary"><span class="stars" aria-hidden="true">★★★★★</span> <strong>5.0</strong> from 90+ Google reviews</p>
      </div>

      <div class="reviews-grid">
        {reviews.map((r) => (
          <figure class="review-card">
            <div class="stars" role="img" aria-label={`${r.data.rating ?? 5} out of 5 stars`}>{stars(r.data.rating ?? 5)}</div>
            <blockquote>&ldquo;{r.data.quote}&rdquo;</blockquote>
            <figcaption>{r.data.author} <span>{r.data.source ?? 'Google review'}</span></figcaption>
          </figure>
        ))}
      </div>

      <div class="gallery-cta">
        <a href="https://www.google.com/maps/search/?api=1&amp;query=Rod%27s+Auto+Body+885+Ivy+Dr+Lancaster+PA" class="btn btn-primary" target="_blank" rel="noopener">Read More Reviews on Google</a>
      </div>
    </div>
  </section>

  <section class="section cta-band texture-panel">
    <div class="container">
      <h2>Need a Repair? Stop By &mdash; No Appointment Needed</h2>
      <p>Walk-ins are always welcome at our Lancaster shop, Monday through Friday, 7AM&ndash;4PM.</p>
      <a href="tel:7172855575" class="phone">(717) 285-5575</a>
    </div>
    <div class="skew-edge" style="background: var(--navy-dark);"></div>
  </section>
</Site>
