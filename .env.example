# Base URL of the Scribe admin app (no trailing slash). The contact form
# posts to `${PUBLIC_SCRIBE_API_URL}/api/submissions`. Set this as an
# Actions repository variable (Settings > Secrets and variables > Actions >
# Variables) named PUBLIC_SCRIBE_API_URL so the deploy workflow picks it up
# at build time — swap it when the admin app's domain changes (e.g. moving
# behind the Cloudflare Tunnel in 6.3) without editing any component.
PUBLIC_SCRIBE_API_URL=https://app.scribecms.com
